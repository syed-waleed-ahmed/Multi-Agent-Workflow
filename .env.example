# ---------------------------------------------------------------------------
# Campaign Forge configuration
# Copy this file to `.env` and fill in your credentials.
# All variables are optional except an API key.
# ---------------------------------------------------------------------------

# --- Authentication (one of these is required) ------------------------------
# Groq API key (default provider - free tier friendly, OpenAI-compatible).
GROQ_API_KEY=your-groq-api-key-here
# Alternatively, use an OpenAI key (also set CF_BASE_URL below to OpenAI's URL).
# OpenAI is a paid provider: it is refused unless CF_FREE_ONLY=false.
# OPENAI_API_KEY=your-openai-api-key-here

# Optional keys for other free-tier providers (2.0 provider layer).
# Read docs/FREE_TIER_POLICY.md first: some free tiers allow the provider to use
# your prompts to improve its products.
# GEMINI_API_KEY=your-gemini-api-key-here        # GOOGLE_API_KEY is also accepted
# MISTRAL_API_KEY=your-mistral-api-key-here
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# --- Model / provider settings ---------------------------------------------
# OpenAI-compatible base URL. Defaults to Groq.
# CF_BASE_URL=https://api.groq.com/openai/v1
# CF_MODEL=qwen/qwen3.8-27b       # verified on Groq 2026-11-10
# CF_TEMPERATURE=0.5
# CF_MAX_TOKENS=800            # per-call output cap. Must be high enough for the
#                              # manager's full brief: a response truncated at the
#                              # limit raises an error instead of saving partial
#                              # output. To stay under a tokens-per-minute quota,
#                              # lower CF_MAX_WORKERS rather than this value.

# --- Provider routing and policy (2.0) --------------------------------------
# CF_PROVIDER=groq             # groq | gemini | mistral | cloudflare | fake
#                              # (default: inferred from CF_BASE_URL)
# CF_FREE_ONLY=true            # refuse providers not marked free-tier eligible.
#                              # Campaign Forge cannot see your account's billing:
#                              # use keys from accounts with no billing attached.
# CF_PROVIDER_MODELS={"gemini": "<model-id>", "mistral": "<model-id>"}
#                              # model per provider (JSON). Required for every
#                              # provider except Groq, which has a known default.
# CF_FALLBACK_PROVIDERS=       # e.g. "mistral,gemini". Used ONLY after a quota or
#                              # rate-limit failure, and always recorded on output.
# CF_AGENT_OVERRIDES={"manager": {"max_tokens": 1500}}
#                              # per-agent provider/model/temperature/max_tokens
#                              # (JSON). Raising the manager's max_tokens avoids
#                              # truncating the final brief.
# CF_PROVIDER_CONCURRENCY={"groq": 1}
#                              # requests in flight per provider. Groq's free tier
#                              # caps output tokens per minute, so its default is 1;
#                              # raise it only on a paid tier.

# --- Resilience -------------------------------------------------------------
# CF_REQUEST_TIMEOUT=60        # seconds per LLM request
# CF_MAX_RETRIES=4             # retries on transient API errors (honours Retry-After)

# --- Batch / scale ----------------------------------------------------------
# CF_MAX_WORKERS=4             # concurrent campaigns in batch mode

# --- Output / logging -------------------------------------------------------
# CF_OUTPUT_DIR=outputs        # where generated briefs are saved
# CF_RUNS_DIR=outputs/runs     # where `campaign-forge execute` checkpoints runs

# --- Memory and persistence (2.0) --------------------------------------------
# CF_MEMORY_DB=outputs/campaign_forge.db   # brand profiles, history, notes (SQLite)
# CF_RUN_STORE=json            # json (files in CF_RUNS_DIR) or sqlite (CF_MEMORY_DB)
# CF_MEMORY_HISTORY=true       # remember completed runs as searchable history

# --- HTTP API (2.0) ------------------------------------------------------------
# CF_API_KEYS=                 # comma-separated API keys; each key is its own tenant.
#                              # Unset: every /api/v1 request gets 401 (closed by default).
# CF_API_RATE_LIMIT=120        # requests per minute, per key
# CF_API_RUN_LIMIT=10          # run starts (start, resume, approve) per minute, per key
# CF_API_MAX_ACTIVE_RUNS=4     # background runs executing at once in one process

# --- Research tools (2.0) ----------------------------------------------------
# CF_RESEARCH_TOOLS=wikipedia  # search tools for research agents: wikipedia, tavily
#                              # (comma-separated; empty disables searching)
# TAVILY_API_KEY=your-tavily-key   # free tier: 1,000 credits/month, no card
# CF_LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR
